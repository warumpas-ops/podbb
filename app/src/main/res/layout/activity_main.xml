<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bb_black">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingLeft="14dp"
        android:paddingRight="10dp"
        android:background="@color/header_bg">

        <TextView
            android:id="@+id/tvAppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="PodBB [podcasts]"
            android:textColor="@color/bb_text_white"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center_vertical" />

        <Button
            android:id="@+id/btnHeaderDownloads"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="[downloads]"
            android:textColor="@color/bb_text_white"
            android:background="@null"
            android:textSize="12sp"
            android:paddingLeft="4dp"
            android:paddingRight="4dp" />

        <Button
            android:id="@+id/btnHeaderSettings"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="[settings]"
            android:textColor="@color/bb_blue"
            android:background="@null"
            android:textSize="12sp"
            android:paddingLeft="4dp"
            android:paddingRight="4dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bb_border" />

    <!-- Search Bar -->
    <LinearLayout
        android:id="@+id/searchContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:hint="search podcasts or paste RSS url..."
            android:textColorHint="@color/bb_text_dim"
            android:textColor="@color/bb_text_white"
            android:background="@drawable/input_bg"
            android:textSize="13sp"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionSearch" />
    </LinearLayout>

    <!-- Section Header -->
    <TextView
        android:id="@+id/tvSectionHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MY SUBSCRIPTIONS"
        android:textColor="@color/bb_text_dim"
        android:textSize="11sp"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="2dp"
        android:paddingBottom="4dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- SUBSCRIPTIONS: Grid of covers only -->
        <GridView
            android:id="@+id/gridSubscriptions"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:numColumns="3"
            android:horizontalSpacing="3dp"
            android:verticalSpacing="3dp"
            android:padding="3dp"
            android:stretchMode="columnWidth"
            android:visibility="gone" />

        <!-- SEARCH RESULTS: Full list with info -->
        <ListView
            android:id="@+id/listPodcasts"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@color/bb_border"
            android:dividerHeight="1dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvEmpty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="[ no podcasts subscribed ]\n\ntype keywords above to search\nor paste an RSS feed url"
            android:textColor="@color/bb_text_dim"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Mini Player Bar -->
    <LinearLayout
        android:id="@+id/miniPlayerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/bb_border" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/bb_card"
            android:paddingLeft="14dp"
            android:paddingRight="10dp">

            <LinearLayout
                android:id="@+id/miniPlayerClickArea"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMiniTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/bb_text_white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/tvMiniPodcast"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/bb_text_dim"
                    android:textSize="11sp"
                    android:singleLine="true" />
            </LinearLayout>

            <Button
                android:id="@+id/btnMiniPlayPause"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="[play]"
                android:textColor="@color/bb_blue"
                android:background="@null"
                android:textSize="12sp"
                android:paddingLeft="8dp"
                android:paddingRight="8dp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bb_border" />

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/btnBottomDownloads"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="[↓ offline downloads]"
            android:textColor="@color/bb_text_white"
            android:background="@drawable/btn_bb_action"
            android:textSize="12sp"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp" />

        <Button
            android:id="@+id/btnBottomPlayer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="[▶ now playing]"
            android:textColor="@color/bb_blue"
            android:background="@drawable/btn_bb_action"
            android:textSize="12sp"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp" />
    </LinearLayout>

</LinearLayout>
