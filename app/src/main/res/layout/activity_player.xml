<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bb_black">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/header_bg"
        android:paddingLeft="10dp"
        android:paddingRight="12dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:text="← Back"
            android:textColor="@color/bb_text_white"
            android:background="@drawable/btn_bb_action"
            android:textSize="12sp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="PodBB [now playing]"
            android:textColor="@color/bb_text_white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <View
            android:layout_width="60dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bb_border" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:paddingTop="14dp"
            android:paddingBottom="20dp">

            <!-- Artwork Badge (NoteVault Card style) -->
            <ImageView
                android:id="@+id/imgArtwork"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_launcher"
                android:scaleType="centerCrop"
                android:background="@drawable/card_bg"
                android:padding="6dp"
                android:layout_marginBottom="12dp" />

            <!-- Source pill badge -->
            <TextView
                android:id="@+id/tvSourceBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[STREAMING]"
                android:textColor="@color/bb_blue"
                android:textSize="11sp"
                android:layout_marginBottom="6dp" />

            <!-- Episode Title -->
            <TextView
                android:id="@+id/tvEpisodeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Episode Title"
                android:textColor="@color/bb_text_white"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="3"
                android:ellipsize="end" />

            <!-- Podcast Name -->
            <TextView
                android:id="@+id/tvPodcastName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:layout_marginTop="3dp"
                android:text="Podcast Name"
                android:textColor="@color/bb_text_dim"
                android:textSize="12sp"
                android:singleLine="true" />

            <!-- Progress Bar & Timestamps -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/tvCurrentTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="@color/bb_text_dim"
                    android:textSize="11sp" />

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginLeft="6dp"
                    android:layout_marginRight="6dp" />

                <TextView
                    android:id="@+id/tvDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="@color/bb_text_dim"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Hero Controls -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="14dp">

                <Button
                    android:id="@+id/btnSkipBack"
                    android:layout_width="65dp"
                    android:layout_height="38dp"
                    android:text="[-30s]"
                    android:textColor="@color/bb_text_white"
                    android:background="@drawable/btn_bb_action"
                    android:textSize="12sp"
                    android:layout_marginRight="10dp" />

                <Button
                    android:id="@+id/btnPlayPause"
                    android:layout_width="110dp"
                    android:layout_height="42dp"
                    android:text="[Play]"
                    android:textColor="@color/bb_blue"
                    android:background="@drawable/btn_bb_action"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnSkipForward"
                    android:layout_width="65dp"
                    android:layout_height="38dp"
                    android:text="[+30s]"
                    android:textColor="@color/bb_text_white"
                    android:background="@drawable/btn_bb_action"
                    android:textSize="12sp"
                    android:layout_marginLeft="10dp" />
            </LinearLayout>

            <!-- Speed selector (NoteVault button style) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginTop="16dp">

                <Button android:id="@+id/btnSpeed075" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:text="0.75x" android:textColor="@color/bb_text_dim" android:background="@drawable/btn_bb_action" android:textSize="11sp" android:layout_marginRight="3dp" />
                <Button android:id="@+id/btnSpeed100" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:text="1.0x" android:textColor="@color/bb_blue" android:background="@drawable/btn_bb_action" android:textSize="11sp" android:layout_marginRight="3dp" />
                <Button android:id="@+id/btnSpeed125" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:text="1.25x" android:textColor="@color/bb_text_dim" android:background="@drawable/btn_bb_action" android:textSize="11sp" android:layout_marginRight="3dp" />
                <Button android:id="@+id/btnSpeed150" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:text="1.5x" android:textColor="@color/bb_text_dim" android:background="@drawable/btn_bb_action" android:textSize="11sp" android:layout_marginRight="3dp" />
                <Button android:id="@+id/btnSpeed200" android:layout_width="0dp" android:layout_height="32dp" android:layout_weight="1" android:text="2.0x" android:textColor="@color/bb_text_dim" android:background="@drawable/btn_bb_action" android:textSize="11sp" />
            </LinearLayout>

            <!-- Download Button -->
            <Button
                android:id="@+id/btnDownload"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:text="[↓ download for offline playback]"
                android:textColor="@color/bb_text_white"
                android:background="@drawable/btn_bb_action"
                android:textSize="12sp"
                android:layout_marginTop="16dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
